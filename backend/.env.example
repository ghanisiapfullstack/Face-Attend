# Salin ke backend/.env  jangan commit backend/.env

SECRET_KEY="your-secret-key-here"

# Supabase PostgreSQL connection string
# Ambil dari: Supabase Dashboard → Project Settings → Database → Connection string → URI
# Gunakan "Transaction" pooler (port 6543) untuk kompatibilitas terbaik
DATABASE_URL=postgresql+psycopg2://postgres.xxxx:YOUR_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

ALLOW_PUBLIC_REGISTER=true

# Akurasi wajah InsightFace (threshold berbeda dari DeepFace)
# FACE_MATCH_THRESHOLD=0.4   (default, InsightFace cosine scale 0-1)
# FACE_MATCH_MARGIN=0.05     (selisih minimum skor #1 vs #2)